{
  "name": "Keycloak",
  "slug": "keycloak",
  "category": "security",
  "website": "https://www.keycloak.org",
  "repo": "https://github.com/keycloak/keycloak",
  "description": "Open-source identity and access management server providing single sign-on, authentication, and authorization.",
  "status": "live",
  "specs": {
    "ram_min_mb": {
      "value": 750,
      "source_url": "https://raw.githubusercontent.com/keycloak/keycloak/main/docs/guides/server/containers.adoc",
      "quote": "you should set the memory limit to at least 750 MB",
      "retrieved": "2026-08-12",
      "scope": "Docker container, general (container memory limit needed to approach the previous 512 MB max heap default)"
    },
    "ram_rec_mb": {
      "value": 2048,
      "source_url": "https://raw.githubusercontent.com/keycloak/keycloak/main/docs/guides/server/containers.adoc",
      "quote": "the recommended memory limit is 2 GB",
      "retrieved": "2026-08-12",
      "scope": "Docker container, smaller production-ready deployments"
    },
    "no_official_figure": {
      "fields": [
        "cpu_min_cores",
        "cpu_rec_cores"
      ],
      "evidence_url": "https://raw.githubusercontent.com/keycloak/keycloak/main/docs/guides/server/containers.adoc",
      "note": "The container-memory guide sizes RAM/heap explicitly but states no CPU core count anywhere in the container or production-configuration docs."
    }
  },
  "deps": [
    {
      "service": "postgresql",
      "required": false,
      "source_url": "https://raw.githubusercontent.com/keycloak/keycloak/main/docs/guides/server/templates/databases.adoc"
    },
    {
      "service": "mysql",
      "required": false,
      "source_url": "https://raw.githubusercontent.com/keycloak/keycloak/main/docs/guides/server/templates/databases.adoc"
    },
    {
      "service": "mariadb",
      "required": false,
      "source_url": "https://raw.githubusercontent.com/keycloak/keycloak/main/docs/guides/server/templates/databases.adoc"
    }
  ],
  "docker": {
    "image": "keycloak/keycloak",
    "size_mb": 255,
    "arches": [
      "amd64",
      "arm64"
    ],
    "source_url": "https://hub.docker.com/r/keycloak/keycloak",
    "retrieved": "2026-08-24"
  },
  "sources_of_truth": [
    "https://raw.githubusercontent.com/keycloak/keycloak/main/docs/guides/server/containers.adoc",
    "https://raw.githubusercontent.com/keycloak/keycloak/main/docs/guides/server/db.adoc",
    "https://raw.githubusercontent.com/keycloak/keycloak/main/docs/guides/server/templates/databases.adoc",
    "https://hub.docker.com/r/keycloak/keycloak"
  ]
}
